#' Joint Bayesian age-depth model of radioisotopic dates and a floating astrochronology (astroMCBchron)
#'
#' @description
#' \code{astroMCBchron()} combines radioisotopic dates (e.g. CA-ID-TIMS U-Pb) with a
#' floating astrochronology (the tracked period of an astronomical cycle, typically the
#' 405-kyr eccentricity cycle, as obtained with \code{\link{track_period_wavelet}},
#' \code{\link{completed_series}} or \code{\link{retrack_wt_MC}}) in one joint posterior
#' distribution. The floating astrochronology is not treated as exact: between each pair of
#' dates its duration is multiplied by a stretch factor whose prior width is set by the
#' tracking uncertainty (the spread between independently tracked proxies), and the duration
#' of every hiatus is estimated together with the age model. The dates enter the likelihood
#' only, so the astrochronology and the dates remain independent sources of information.
#'
#' The model (Arts et al., in prep.):
#' \itemize{
#'   \item the record is divided into intervals bounded by the dated horizons and the top and
#'   base of the record. In interval \emph{j} the floating duration (number of tracked cycles
#'   x \code{target_period}) is multiplied by a stretch factor \emph{s_j}, with
#'   log \emph{s_j} ~ N(0, tau_j^2 + tau0^2). tau_j is the standard error of the floating
#'   duration of the interval (between-proxy spread / sqrt(n proxies)) and tau0 a common
#'   additional slack with a half-normal prior (sd = \code{tau0_sd}). The two outer
#'   intervals, which are not bracketed by dates, are tied to their neighbours
#'   (sd = \code{outer_sd} in log units);
#'   \item each hiatus has a duration H with a normal prior (\code{hiatuses$mean},
#'   \code{hiatuses$sd}), truncated at zero;
#'   \item the stratigraphic position of each date may vary uniformly within
#'   +/- \code{thickness};
#'   \item the floating astrochronology is drawn from the realisations of the tracked period
#'   (one realisation per segment and MCMC state);
#'   \item the age of every position follows from the age of an anchor date plus the
#'   cumulative stretched floating durations and the hiatuses;
#'   \item the dates are screened in two stages: a robust Student-t stage flags dates that
#'   move more than \code{outlier_z} standard deviations; in the second stage the retained
#'   dates have a Gaussian likelihood and flagged dates only enter as a weak guard
#'   (\code{outlier_k} times their uncertainty);
#'   \item the within-interval uncertainty is added as a monotone gamma (Dirichlet) bridge
#'   between the dates (free gamma walks beyond the outermost dates), with a dispersion per
#'   cycle equal to the relative between-proxy spread of the cycle durations; the reported 2
#'   sd is computed analytically (Rao-Blackwellised) from the posterior draws;
#'   \item optionally, every date is predicted from all other dates and the astrochronology
#'   (leave-one-out), which tests the consistency between dates and cycles.
#' }
#' With \code{bchron = TRUE}, a U-Pb-only Bayesian age-depth model with the same dates
#' (\code{\link{modBchron}}, a pure-R implementation of modifiedBChron; Trayler et al.,
#' 2020; Haslett and Parnell, 2008) is run alongside, on the same prediction grid, so that
#' both models and the reduction in uncertainty can be compared directly.
#'
#' @param dates data.frame with one row per dated horizon and columns \code{id},
#'   \code{age}, \code{sd} (1 sigma, same unit as \code{age}), \code{position} and, optionally,
#'   \code{thickness} (half thickness of the stratigraphic position uncertainty; default 0).
#'   Ages are given in \code{age_unit}. Use the internal (analytical) uncertainty when all
#'   dates come from the same laboratory and tracer.
#' @param tracks list with one element per continuous segment (number of hiatuses + 1),
#'   ordered from the youngest (top) to the oldest (base) segment. Each element is either
#'   (i) a list with \code{position} (vector) and \code{period} (matrix, positions x
#'   realisations, or a vector), (ii) the output of \code{\link{retrack_wt_MC}} style
#'   objects, i.e. a list whose first element is a matrix with the position in its first
#'   column and whose second element is the matrix of period realisations, or (iii) a
#'   matrix/data.frame with position in the first column and one or more period
#'   realisations in the other columns. Periods are in position units (e.g. m) per
#'   \code{target_period}.
#' @param hiatuses optional data.frame with columns \code{position}, \code{mean} and
#'   \code{sd} (1 sigma; duration prior in kyr). Default \code{NULL} (no hiatus).
#' @param position_type "depth" (positions increase downwards, default) or "height"
#'   (positions increase upwards).
#' @param age_unit unit of \code{dates$age}, \code{dates$sd} and of the output: "Ma"
#'   (default) or "ka" (= kyr).
#' @param target_period period of the tracked cycle (kyr). Default 405.
#' @param proxy_tracks optional list (one element per segment) of named lists of single
#'   per-proxy tracks (data.frame or matrix with position and period). Used to compute
#'   tau (stretch prior) and eps (within-interval spread) from the between-proxy spread.
#' @param tau optional numeric vector (one value per interval between consecutive dates,
#'   log units, or a single value used for all intervals) that overrides the computed
#'   stretch-prior widths.
#' @param tau_method "se" (between-proxy sd / sqrt(n), default) or "sd" (between-proxy
#'   sd). Only used with \code{proxy_tracks}. Without \code{proxy_tracks}, tau is the sd of
#'   the log floating durations over the track realisations.
#' @param eps optional within-interval relative spread per cycle: a single number, or a
#'   data.frame with \code{position} and \code{eps}. Default: computed from
#'   \code{proxy_tracks} (between-proxy standard error per cycle) or, without them, from
#'   the spread of the track realisations.
#' @param tau0_sd sd of the half-normal prior on the common slack tau0 (log units).
#'   Default 0.03. Set to 0 to fix tau0 at 0.
#' @param outer_sd sd (log units) tying the stretch factors of the outer intervals to their
#'   neighbours. Default 0.2.
#' @param anchor id of the date used as anchor. Default: the most precise date.
#' @param two_stage logical; robust two-stage outlier screening (default TRUE).
#' @param nu degrees of freedom of the Student-t likelihood in stage 1. Default 4.
#' @param outlier_z flag a date when its stage-1 shift exceeds \code{outlier_z} x its sd.
#' @param outlier_k flagged dates enter stage 2 with \code{outlier_k} x their sd.
#' @param n_iter number of MCMC iterations (stage 2; stage 1 uses half). Default 3e5.
#' @param thin thinning interval. Default 50.
#' @param burn_frac fraction of iterations discarded as burn-in (and used for adapting the
#'   proposal widths). Default 0.2.
#' @param n_tracks number of track realisations drawn per segment. Default 1000.
#' @param loo logical; leave-one-out prediction of every date. Default TRUE.
#' @param loo_iter iterations per leave-one-out run. Default \code{n_iter / 3}.
#' @param predict_positions positions at which the model is evaluated. Default: 501
#'   equidistant positions spanning the dates and the tracks.
#' @param max_curves maximum number of age-depth curves stored. Default 5000.
#' @param n_bridge bridge realisations per posterior draw used for the percentiles
#'   (default: enough for >= 10,000 curves, at most 20).
#' @param date_loglik optional list (one function per date, same order as \code{dates})
#'   returning the log-likelihood of an age (in \code{age_unit}); replaces the Gaussian date
#'   likelihood (e.g. for Bayesian eruption-age estimates). Disables the two-stage screening.
#' @param bchron logical; also run the U-Pb-only \code{\link{modBchron}} model with the same
#'   dates. Default FALSE.
#' @param bchron_split logical; with hiatuses, run one \code{modBchron} model per segment
#'   (dates within the segment) and estimate the hiatus duration from the difference
#'   between the models at the hiatus (as in Cramer et al., 2026). Default FALSE (one model
#'   through all dates).
#' @param bchron_args list of further arguments passed to \code{\link{modBchron}} (e.g.
#'   \code{MC}, \code{burn}, \code{truncateUp}, \code{truncateDown}).
#' @param seed optional random seed.
#' @param verbose logical; print progress. Default TRUE.
#' @param genplot logical; plot the result. Default FALSE.
#'
#' @return An object of class \code{astroMCBchron}: a list with
#' \describe{
#'   \item{model}{matrix of age-depth curves (rows = \code{predictPositions}, columns =
#'   realisations), in \code{age_unit}; the same layout as the \code{model} element of
#'   \code{\link{modBchron}} output.}
#'   \item{predictPositions}{positions of the rows of \code{model}.}
#'   \item{summary}{data.frame: position, mean, median, 2.5 and 97.5 percentiles and the
#'   analytical 2 sd (age_unit, 2 sd in kyr).}
#'   \item{dates}{data.frame: date, posterior age and 2 sd, shift (kyr) and shift in sd of
#'   the date, outlier flag, leave-one-out prediction and z-score.}
#'   \item{stretch}{matrix of posterior stretch factors (draws x intervals).}
#'   \item{hiatus}{matrix of posterior hiatus durations (kyr).}
#'   \item{tau, tau0, eps}{stretch-prior widths, posterior of the common slack and the
#'   within-interval spread profile.}
#'   \item{stage1, loo}{stage-1 screening and leave-one-out tables.}
#'   \item{bchron, comparison}{the \code{modBchron} model(s) and a comparison table of the
#'   2 sd of both models (if \code{bchron = TRUE}).}
#'   \item{posterior, acceptance, call, settings}{raw posterior states, acceptance rates
#'   and settings.}
#' }
#'
#' @references
#' Haslett, J., Parnell, A., 2008. A simple monotone process with application to
#' radiocarbon-dated depth chronologies. Journal of the Royal Statistical Society C 57,
#' 399-418.
#'
#' Trayler, R.B., Schmitz, M.D., Cuitino, J.I., Kohn, M.J., Bargo, M.S., Kay, R.F.,
#' Stromberg, C.A.E., Vizcaino, S.F., 2020. An improved approach to age-modeling in deep
#' time: Implications for the Santa Cruz Formation, Argentina. GSA Bulletin 132, 233-244.
#'
#' Cramer, B.D., Schmitz, M.D., Trayler, R.B., Stolfus, B.M., Peate, D.W., McAdams,
#' N.E.B., Arts, M., Da Silva, A.-C., 2026. Quantifying uncertainty in the structure and
#' duration of Silurian biogeochemical events. Scientific Reports.
#'
#' @examples
#' \donttest{
#' ## synthetic example: constant accumulation of 2 cm/kyr (405 kyr = 8.1 m),
#' ## a 300-kyr hiatus at 60 m and five dates
#' set.seed(1)
#' true_age <- function(z) 400000 + z / 0.02 + ifelse(z > 60, 300, 0)      # kyr
#' z_dates <- c(10, 35, 55, 70, 95)
#' dates <- data.frame(id = paste0("ash", 1:5), position = z_dates,
#'                     age = true_age(z_dates) / 1000 + rnorm(5, 0, 0.03), sd = 0.03,
#'                     thickness = 0.5)
#' trk <- function(z) list(position = z, period = sapply(1:200, function(i)
#'   8.1 * exp(rnorm(1, 0, 0.03)) * (1 + 0.02 * sin(z / 7 + runif(1, 0, 6)))))
#' fit <- astroMCBchron(dates, tracks = list(trk(seq(0, 60, 0.25)), trk(seq(60, 100, 0.25))),
#'                      hiatuses = data.frame(position = 60, mean = 280, sd = 60),
#'                      n_iter = 20000, loo = FALSE, bchron = TRUE,
#'                      bchron_args = list(MC = 3000, burn = 1000))
#' fit
#' plot(fit)
#' }
#' @importFrom stats approx dnorm dt median quantile rgamma rnorm runif sd var setNames
#' @export
astroMCBchron <- function(dates, tracks, hiatuses = NULL, position_type = c("depth", "height"),
                          age_unit = c("Ma", "ka"), target_period = 405,
                          proxy_tracks = NULL, tau = NULL, tau_method = c("se", "sd"), eps = NULL,
                          tau0_sd = 0.03, outer_sd = 0.2, anchor = NULL,
                          two_stage = TRUE, nu = 4, outlier_z = 3, outlier_k = 4,
                          n_iter = 3e5, thin = 50, burn_frac = 0.2, n_tracks = 1000,
                          loo = TRUE, loo_iter = NULL, predict_positions = NULL,
                          max_curves = 5000, n_bridge = NULL, date_loglik = NULL,
                          bchron = FALSE, bchron_split = FALSE, bchron_args = list(),
                          seed = NULL, verbose = TRUE, genplot = FALSE) {
  cl <- match.call()
  position_type <- match.arg(position_type); age_unit <- match.arg(age_unit); tau_method <- match.arg(tau_method)
  if (!is.null(seed)) set.seed(seed)
  sc <- if (age_unit == "Ma") 1000 else 1                                 # input unit -> kyr
  sgn <- if (position_type == "depth") 1 else -1                           # internal z: increases with age
  msg <- function(...) if (verbose) cat(sprintf(...))
  ## ---------------------------------------------------------------- dates
  dates <- as.data.frame(dates)
  for (nm in c("age", "sd", "position")) if (is.null(dates[[nm]])) stop("dates needs a column '", nm, "'")
  if (is.null(dates$id)) dates$id <- paste0("date_", seq_len(nrow(dates)))
  if (is.null(dates$thickness)) dates$thickness <- 0
  if (nrow(dates) < 2) stop("at least two dates are needed")
  if (any(!is.finite(dates$age) | !is.finite(dates$sd) | dates$sd <= 0)) stop("dates: ages and sds must be finite and sds > 0")
  ord <- order(sgn * dates$position); dates <- dates[ord, ]; rownames(dates) <- NULL
  if (!is.null(date_loglik)) { date_loglik <- date_loglik[ord]; two_stage <- FALSE }
  nb <- nrow(dates); zb <- sgn * dates$position; th <- abs(dates$thickness)
  age_k <- dates$age * sc; sd_k <- dates$sd * sc
  if (any(diff(zb) <= 0)) stop("two dates share the same position; combine them first")
  ia <- if (is.null(anchor)) which.min(sd_k) else match(anchor, dates$id)
  if (is.na(ia)) stop("anchor id not found in dates$id")
  ## ---------------------------------------------------------------- hiatuses and segments
  if (!is.null(hiatuses) && nrow(hiatuses)) {
    hiatuses <- as.data.frame(hiatuses); hiatuses <- hiatuses[order(sgn * hiatuses$position), , drop = FALSE]
    zh <- sgn * hiatuses$position; Hm <- hiatuses$mean; Hs <- hiatuses$sd
    if (any(Hs <= 0)) stop("hiatuses$sd must be > 0")
  } else { zh <- numeric(0); Hm <- Hs <- numeric(0) }
  nh <- length(zh); nseg <- nh + 1
  single <- function(x) is.matrix(x) || is.data.frame(x) || (is.list(x) && !is.null(x$position)) ||
    (is.list(x) && length(x) == 2 && (is.matrix(x[[1]]) || is.data.frame(x[[1]])) && is.matrix(x[[2]]) && nrow(as.matrix(x[[1]])) == nrow(x[[2]]) && nseg == 1)
  if (single(tracks)) tracks <- list(tracks)
  if (length(tracks) != nseg) stop(sprintf("tracks must have one element per segment: %d hiatus(es) -> %d segments, got %d", nh, nseg, length(tracks)))
  TRK <- lapply(tracks, .amc_track)
  for (s in seq_len(nseg)) TRK[[s]]$z <- sgn * TRK[[s]]$position
  ## ---------------------------------------------------------------- grid and knots
  zall <- c(zb - th, zb + th, unlist(lapply(TRK, `[[`, "z")))
  zpred <- if (is.null(predict_positions)) seq(min(zall), max(zall), length.out = 501) else sort(unique(sgn * predict_positions))
  ztop <- min(c(zall, zpred)); zbot <- max(c(zall, zpred))
  ## memory guard: the largest objects are the stored age-depth curves (positions x max_curves) and the floating-time
  ## matrices (track positions x n_tracks); stop before allocating them if they do not fit in the free memory
  est_bytes <- 8 * (length(unique(zpred)) * max_curves * 3 + sum(vapply(TRK, function(t) length(t$z), 0)) * n_tracks * 3)
  free_bytes <- wr_ram_available()
  if (!is.na(free_bytes) && est_bytes > 0.7 * free_bytes) {
    stop(sprintf(paste0("astroMCBchron needs about %.1f GB for max_curves = %g, n_tracks = %g and %d prediction positions, ",
                        "but only %.1f GB is free. Reduce max_curves, n_tracks or the number of predict_positions."),
                 est_bytes / 2^30, max_curves, n_tracks, length(unique(zpred)), free_bytes / 2^30), call. = FALSE)
  }
  zg <- sort(unique(zpred))
  if (min(zg) > min(zb) || max(zg) < max(zb)) stop("predict_positions must span all dated positions")
  kn <- c(ztop, zb, zbot); J <- nb + 1
  seg_of <- function(z) findInterval(z, zh, left.open = TRUE) + 1                  # z exactly at a hiatus belongs to the upper segment
  bounds <- c(ztop, zh, zbot)
  ## ---------------------------------------------------------------- floating time per segment (realisations)
  NTR <- n_tracks
  FT <- lapply(seq_len(nseg), function(s) {
    t <- TRK[[s]]; P <- t$period; k <- t$z >= bounds[s] - 1e-9 & t$z <= bounds[s + 1] + 1e-9
    if (sum(k) < 2) k <- rep(TRUE, length(t$z))                               # segment shorter than the track spacing: use all
    zs <- sort(unique(c(bounds[s], t$z[k], bounds[s + 1])))
    Pz <- .amc_interp(t$z, P, zs)
    dr <- if (ncol(P) >= NTR) sample.int(ncol(P), NTR) else sample.int(ncol(P), NTR, replace = TRUE)
    Tz <- .amc_cumfloat(zs, Pz[, dr, drop = FALSE], target_period)
    list(z = zs, T = Tz, draws = dr, mean = .amc_cumfloat(zs, Pz, target_period)) })
  off <- matrix(0, nseg, NTR); if (nseg > 1) for (s in 2:nseg) off[s, ] <- off[s - 1, ] + FT[[s - 1]]$T[nrow(FT[[s - 1]]$T), ]
  Fall <- function(z) { out <- matrix(0, length(z), NTR); s <- seg_of(z)
    for (q in unique(s)) { u <- s == q; out[u, ] <- sweep(.amc_interp(FT[[q]]$z, FT[[q]]$T, z[u]), 2, off[q, ], "+") }
    out }
  Fk <- function(z, k) { out <- numeric(length(z)); s <- seg_of(z)
    for (q in unique(s)) { u <- s == q; out[u] <- off[q, k] + .amc_interp(FT[[q]]$z, FT[[q]]$T[, k, drop = FALSE], z[u])[, 1] }
    out }
  Fkn <- Fall(kn); D <- matrix(t(apply(Fkn, 2, diff)), nrow = NTR)               # NTR x J floating durations per interval
  ivl <- function(z) pmin(pmax(findInterval(z, kn, rightmost.closed = TRUE), 1), J)
  LOC <- lapply(seq_len(nb), function(i) { m <- if (th[i] > 0) 41 else 1
    dz <- if (m > 1) seq(-th[i], th[i], length.out = m) else 0; zl <- pmin(pmax(zb[i] + dz, ztop), zbot); jl <- ivl(zl)
    list(dz = dz, j = jl, f = t(Fall(zl) - Fkn[jl, , drop = FALSE]), hz = if (nh) outer(zl, zh, ">") * 1 else matrix(0, m, 0)) })
  ## ---------------------------------------------------------------- tau (stretch prior) and eps (within-interval spread)
  PT <- NULL
  if (!is.null(proxy_tracks)) {
    if (length(proxy_tracks) != nseg) stop("proxy_tracks must have one element (named list of proxy tracks) per segment")
    PT <- lapply(seq_len(nseg), function(s) lapply(proxy_tracks[[s]], function(x) { x <- as.matrix(x)
      z <- sgn * x[, 1]; o <- order(z); z <- z[o]; p <- x[o, 2]; k <- is.finite(p) & p > 0
      zs <- sort(unique(c(bounds[s], z[k & z >= bounds[s] & z <= bounds[s + 1]], bounds[s + 1])))
      list(z = zs, T = .amc_cumfloat(zs, .amc_interp(z[k], matrix(p[k]), zs), target_period)[, 1]) }))
  }
  pfloat <- function(nm, z) { s <- seg_of(z); out <- numeric(length(z)); tot <- 0
    for (q in seq_len(nseg)) { x <- PT[[q]][[nm]]; if (is.null(x)) { if (any(s == q)) return(NA) else next }
      u <- s == q; out[u] <- tot + approx(x$z, x$T, z[u], rule = 2)$y; tot <- tot + x$T[length(x$T)] }
    out }
  inner <- if (J > 2) 2:(J - 1) else integer(0)
  ilab <- sprintf("%s-%s", format(sgn * kn[-length(kn)], nsmall = 2), format(sgn * kn[-1], nsmall = 2))
  if (!is.null(tau)) { if (length(tau) == 1) tau <- rep(tau, length(inner)); if (length(tau) != length(inner)) stop(sprintf("tau must have %d values (one per interval between dates)", length(inner))); tau_v <- tau; tau_src <- "user" }
  else if (!is.null(PT)) {
    tau_v <- sapply(inner, function(j) { sj <- unique(seg_of(c(kn[j] + 1e-9, kn[j + 1])))
      sj <- seq(min(sj), max(sj)); nms <- Reduce(intersect, lapply(sj, function(q) names(PT[[q]])))
      if (length(nms) < 2) return(NA)
      d <- sapply(nms, function(nm) diff(pfloat(nm, c(kn[j], kn[j + 1])))); d <- d[is.finite(d) & d > 0]
      if (length(d) < 2) return(NA); sd(log(d)) / if (tau_method == "se") sqrt(length(d)) else 1 })
    if (any(!is.finite(tau_v))) { msg("tau: fewer than two proxies in some intervals; using the track-realisation spread there\n")
      tau_v[!is.finite(tau_v)] <- apply(log(D[, inner, drop = FALSE]), 2, sd)[!is.finite(tau_v)] }
    tau_src <- paste0("proxy ", tau_method)
  } else { tau_v <- apply(log(pmax(D[, inner, drop = FALSE], 1e-9)), 2, sd); tau_src <- "track realisations" }
  names(tau_v) <- ilab[inner]
  ## eps per cycle -> continuous profile on zg
  EPS <- .amc_eps(eps, FT, PT, zg, zh, bounds, target_period, sgn)
  cz <- EPS$profile^2 * target_period
  ## ---------------------------------------------------------------- likelihood and prior
  logL_fun <- function(type, mult) {
    if (!is.null(date_loglik)) return(function(i, a) { v <- date_loglik[[i]](a / sc); ifelse(is.finite(v), v, -1e6) })
    function(i, a) { x <- (a - age_k[i]) / (sd_k[i] * mult[i]); if (type[i] == "t") dt(x, nu, log = TRUE) - dt(0, nu, log = TRUE) else -0.5 * x^2 }
  }
  logL_date <- logL_fun(rep(if (two_stage) "t" else "n", nb), rep(1, nb))
  ages_beds <- function(p) { cs <- c(0, cumsum(p$s * D[p$k, ]))
    G <- vapply(seq_len(nb), function(i) { L <- LOC[[i]]; m <- p$m[i]; j <- L$j[m]
      cs[j] + p$s[j] * L$f[p$k, m] + if (nh) sum(p$H * L$hz[m, ]) else 0 }, 0)
    p$A + G - G[ia] }
  Gz <- function(z, p) { F <- Fk(z, p$k); Fn <- Fk(kn, p$k); j <- ivl(z); cs <- c(0, cumsum(p$s * diff(Fn)))
    cs[j] + p$s[j] * (F - Fn[j]) + if (nh) as.vector(outer(z, zh, ">") %*% p$H) else 0 }
  ages_z <- function(z, p) { za <- zb[ia] + LOC[[ia]]$dz[p$m[ia]]; g <- Gz(c(z, za), p); p$A + g[seq_along(z)] - g[length(g)] }
  t0max <- max(tau0_sd, 1e-12)
  lprior <- function(p) {
    if (any(p$s <= 0) || (nh && any(p$H <= 0)) || p$tau0 < 0) return(-Inf)
    ls <- log(p$s); lp <- 0
    if (length(inner)) lp <- lp + sum(dnorm(ls[inner], 0, sqrt(tau_v^2 + p$tau0^2 + 1e-12), log = TRUE))
    lp <- lp + dnorm(ls[1] - ls[2], 0, outer_sd, log = TRUE) + dnorm(ls[J] - ls[J - 1], 0, outer_sd, log = TRUE)
    if (tau0_sd > 0) lp <- lp + dnorm(p$tau0, 0, t0max, log = TRUE) + log(max(p$tau0, 1e-12))
    if (nh) lp <- lp + sum(dnorm(p$H, Hm, Hs, log = TRUE))
    lp }
  llik <- function(p, use, LF) { a <- ages_beds(p); sum(vapply(which(use), function(i) LF(i, a[i]), 0)) }
  ## ---------------------------------------------------------------- MCMC (Metropolis-within-Gibbs, adaptive during burn-in)
  run_mcmc <- function(use, niter, LF) {
    p <- list(A = age_k[ia], s = rep(1, J), tau0 = if (tau0_sd > 0) tau0_sd else 0, H = Hm,
              m = vapply(LOC, function(L) as.integer((length(L$dz) + 1) / 2), 1L), k = 1L)
    lp <- lprior(p) + llik(p, use, LF)
    step <- list(A = min(sd_k), s = 0.05, t = 0.8, H = if (nh) Hs else numeric(0), m = pmax(1, round(vapply(LOC, function(L) length(L$dz), 1) / 6)))
    nacc <- c(A = 0, s = 0, t = 0, H = 0, z = 0, k = 0); win <- nacc; ntry <- nacc; wtry <- nacc
    nburn <- floor(burn_frac * niter); keep <- vector("list", floor((niter - nburn) / thin)); nk <- 0
    movable <- which(vapply(LOC, function(L) length(L$dz), 1) > 1)
    try_q <- function(q, b) { ntry[b] <<- ntry[b] + 1; wtry[b] <<- wtry[b] + 1
      lq <- lprior(q); if (!is.finite(lq)) return(FALSE); lq <- lq + llik(q, use, LF)
      if (log(runif(1)) < lq - lp) { p <<- q; lp <<- lq; nacc[b] <<- nacc[b] + 1; win[b] <<- win[b] + 1; TRUE } else FALSE }
    for (it in seq_len(niter)) {
      q <- p; q$A <- p$A + rnorm(1, 0, step$A); try_q(q, "A")
      for (j in seq_len(J)) { q <- p; q$s[j] <- p$s[j] * exp(rnorm(1, 0, step$s)); try_q(q, "s") }
      if (tau0_sd > 0) { q <- p; q$tau0 <- p$tau0 * exp(rnorm(1, 0, step$t)); try_q(q, "t") }
      if (nh) for (h in seq_len(nh)) { q <- p; q$H[h] <- p$H[h] + rnorm(1, 0, step$H[h]); try_q(q, "H") }
      if (length(movable)) { i <- movable[sample.int(length(movable), 1)]; q <- p
        q$m[i] <- p$m[i] + sample(c(-1L, 1L), 1) * sample.int(step$m[i], 1)
        if (q$m[i] >= 1 && q$m[i] <= length(LOC[[i]]$dz)) try_q(q, "z") }
      if (NTR > 1) { q <- p; q$k <- sample.int(NTR, 1); try_q(q, "k") }
      if (it <= nburn && it %% 200 == 0) {                                       # adapt the step sizes towards ~30% acceptance
        r <- win / pmax(wtry, 1)
        step$A <- step$A * ifelse(r["A"] > 0.3, 1.25, 0.8); step$s <- step$s * ifelse(r["s"] > 0.3, 1.25, 0.8)
        step$t <- step$t * ifelse(r["t"] > 0.3, 1.25, 0.8); if (nh) step$H <- step$H * ifelse(r["H"] > 0.3, 1.25, 0.8)
        win[] <- 0; wtry[] <- 0 }
      if (it > nburn && (it - nburn) %% thin == 0) { nk <- nk + 1; keep[[nk]] <- p } }
    if (nk == 0) { keep <- list(p); nk <- 1 }
    keep <- keep[seq_len(nk)]; attr(keep, "acc") <- round(nacc / pmax(ntry, 1), 2); keep }
  ## ---------------------------------------------------------------- stage 1 / stage 2
  stage1 <- NULL; outlier <- rep(FALSE, nb); t0 <- Sys.time()
  msg("astroMCBchron: %d dates, %d hiatus(es), %d intervals, %d track realisations; tau from %s\n", nb, nh, J, NTR, tau_src)
  if (two_stage) {
    p1 <- run_mcmc(rep(TRUE, nb), round(n_iter / 2), logL_date); P1 <- t(vapply(p1, ages_beds, numeric(nb)))
    sh1 <- colMeans(P1) - age_k; z1 <- sh1 / sd_k; outlier <- abs(z1) > outlier_z
    stage1 <- data.frame(id = dates$id, position = dates$position, date = dates$age, date_sd = dates$sd, stage1 = colMeans(P1) / sc,
                         shift_kyr = round(sh1, 1), shift_sd = round(z1, 2), outlier = outlier)
    msg("stage 1 (Student-t, nu = %g): largest shift %.0f kyr (%.1f sd); %d outlier(s)%s\n", nu, sh1[which.max(abs(z1))], max(abs(z1)),
        sum(outlier), if (any(outlier)) paste0(": ", paste(dates$id[outlier], collapse = ", ")) else "")
  }
  LF2 <- logL_fun(rep("n", nb), ifelse(outlier, outlier_k, 1))
  post <- run_mcmc(rep(TRUE, nb), n_iter, LF2)
  msg("MCMC: %d iterations, %d draws, %.1f min; acceptance %s\n", n_iter, length(post), as.numeric(difftime(Sys.time(), t0, units = "mins")),
      paste(names(attr(post, "acc")), attr(post, "acc"), collapse = " "))
  ## ---------------------------------------------------------------- posterior summaries
  PA <- t(vapply(post, ages_beds, numeric(nb)))
  S <- t(vapply(post, function(p) p$s, numeric(J))); colnames(S) <- ilab
  HH <- if (nh) t(vapply(post, function(p) p$H, numeric(nh))) else matrix(numeric(0), length(post), 0)
  if (nh == 1) HH <- matrix(HH, ncol = 1); if (nh) colnames(HH) <- sprintf("hiatus_%g", sgn * zh)
  T0 <- vapply(post, `[[`, 0, "tau0")
  ## ---------------------------------------------------------------- age-depth ensemble with the gamma bridge
  hstep <- vapply(zh, function(h) which(zg > h)[1], 1L)
  kb <- findInterval(zb[if (any(!outlier)) !outlier else TRUE], zg, rightmost.closed = TRUE)
  incr <- function(p) { a <- ages_z(zg, p); inc <- c(0, pmax(diff(a), 1e-9))
    if (nh) for (h in seq_len(nh)) if (!is.na(hstep[h])) inc[hstep[h]] <- max(inc[hstep[h]] - p$H[h], 1e-9)
    list(a = a, inc = inc) }
  segs <- c(1, kb, length(zg))
  bridge_ages <- function(p, I) { inc <- I$inc; new <- inc
    for (m in seq_len(length(segs) - 1)) { if (segs[m + 1] <= segs[m]) next; ii <- (segs[m] + 1):segs[m + 1]
      g <- rgamma(length(ii), shape = inc[ii] / cz[ii], scale = cz[ii])
      new[ii] <- if (m == 1 || m == length(segs) - 1) g else g / sum(g) * sum(inc[ii]) }
    if (nh) for (h in seq_len(nh)) if (!is.na(hstep[h])) new[hstep[h]] <- new[hstep[h]] + p$H[h]
    out <- numeric(length(zg)); k1 <- kb[1]; out[k1] <- I$a[k1]
    if (k1 < length(zg)) for (i in (k1 + 1):length(zg)) out[i] <- out[i - 1] + new[i]
    if (k1 > 1) for (i in (k1 - 1):1) out[i] <- out[i + 1] - new[i + 1]
    out }
  bridge_var <- function(I) { inc <- I$inc; v <- inc * cz; out <- numeric(length(zg))
    for (m in seq_len(length(segs) - 1)) { if (segs[m + 1] <= segs[m]) next; ii <- (segs[m] + 1):segs[m + 1]
      if (m == 1) { out[segs[m]:(segs[m + 1] - 1)] <- rev(cumsum(rev(v[ii]))); next }
      if (m == length(segs) - 1) { out[ii] <- cumsum(v[ii]); next }
      mu <- cumsum(inc[ii]); Vz <- cumsum(v[ii]); w <- mu / mu[length(ii)]
      out[ii] <- pmax(Vz - 2 * w * Vz + w^2 * Vz[length(ii)], 0) }
    out }
  IN <- lapply(post, incr); PAR <- vapply(IN, `[[`, numeric(length(zg)), "a"); BV <- vapply(IN, bridge_var, numeric(length(zg)))
  sd_rb <- sqrt(apply(PAR, 1, var) + rowMeans(BV))
  nd <- length(post); NBQ <- if (is.null(n_bridge)) max(1L, min(20L, as.integer(ceiling(10000 / nd)))) else as.integer(n_bridge)
  NBS <- max(1L, min(NBQ, as.integer(floor(max_curves / nd))))
  AGQ <- do.call(cbind, lapply(seq_len(nd), function(d) vapply(seq_len(NBQ), function(b) bridge_ages(post[[d]], IN[[d]]), numeric(length(zg)))))
  qq <- apply(AGQ, 1, quantile, c(.025, .5, .975))
  AG <- AGQ[, as.vector(outer(seq_len(NBS), (seq_len(nd) - 1) * NBQ, `+`)), drop = FALSE]; rm(AGQ)
  summ <- data.frame(position = sgn * zg, mean = rowMeans(PAR) / sc, median = qq[2, ] / sc, lower = qq[1, ] / sc, upper = qq[3, ] / sc,
                     sd2_kyr = 2 * sd_rb)
  ## ---------------------------------------------------------------- leave-one-out
  L <- NULL
  if (loo) { li <- if (is.null(loo_iter)) round(n_iter / 3) else loo_iter
    L <- t(vapply(seq_len(nb), function(i) { pp <- run_mcmc(seq_len(nb) != i, li, LF2); a <- vapply(pp, function(p) ages_beds(p)[i], 0)
      c(pred = mean(a), sd = sd(a), z = (mean(a) - age_k[i]) / sqrt(sd(a)^2 + sd_k[i]^2)) }, numeric(3)))
    msg("leave-one-out: %d of %d dates predicted within 2 sd\n", sum(abs(L[, "z"]) <= 2), nb) }
  dtab <- data.frame(id = dates$id, position = dates$position, date = dates$age, date_2sd_kyr = 2 * sd_k,
                     posterior = colMeans(PA) / sc, posterior_2sd_kyr = 2 * apply(PA, 2, sd),
                     shift_kyr = colMeans(PA) - age_k, shift_sd = (colMeans(PA) - age_k) / sd_k, outlier = outlier)
  if (!is.null(L)) { dtab$loo_pred <- L[, "pred"] / sc; dtab$loo_2sd_kyr <- 2 * L[, "sd"]; dtab$loo_z <- L[, "z"] }
  ## ---------------------------------------------------------------- U-Pb-only comparison model
  BC <- NULL; cmp <- NULL
  if (bchron) {
    BC <- .amc_bchron(dates, zg, zh, sgn, sc, bchron_split, bchron_args, verbose)
    cmp <- data.frame(position = sgn * zg, astro_2sd_kyr = 2 * sd_rb, bchron_2sd_kyr = BC$sd2_kyr)
    cmp$reduction_pct <- 100 * (1 - cmp$astro_2sd_kyr / cmp$bchron_2sd_kyr)
    inr <- zg >= min(zb) & zg <= max(zb)
    msg("uncertainty reduction vs modBchron between the outermost dates: mean %.0f%% (median %.0f%%)\n", mean(cmp$reduction_pct[inr], na.rm = TRUE),
        median(cmp$reduction_pct[inr], na.rm = TRUE))
  }
  out <- list(model = AG / sc, predictPositions = sgn * zg, summary = summ, dates = dtab,
              stretch = S, hiatus = HH, tau = tau_v, tau0 = T0, eps = EPS, stage1 = stage1,
              loo = if (is.null(L)) NULL else dtab[, c("id", "position", "date", "loo_pred", "loo_2sd_kyr", "loo_z")],
              bchron = BC, comparison = cmp, posterior = post,
              acceptance = attr(post, "acc"), call = cl,
              settings = list(position_type = position_type, age_unit = age_unit, target_period = target_period, hiatuses = hiatuses,
                              anchor = dates$id[ia], tau_source = tau_src, n_iter = n_iter, thin = thin, n_tracks = NTR,
                              bridge_per_draw = NBQ, curves_stored = ncol(AG)))
  class(out) <- "astroMCBchron"
  if (genplot) plot(out)
  out
}

## ============================================================================= internal helpers
#' @keywords internal
#' @noRd
.amc_track <- function(tr) {
  if (is.list(tr) && !is.data.frame(tr) && !is.null(tr$position)) { pos <- tr$position; P <- tr$period }
  else if (is.list(tr) && !is.data.frame(tr) && length(tr) >= 2 && (is.matrix(tr[[1]]) || is.data.frame(tr[[1]]))) { pos <- as.matrix(tr[[1]])[, 1]; P <- tr[[2]] }
  else if (is.matrix(tr) || is.data.frame(tr)) { tr <- as.matrix(tr); pos <- tr[, 1]; P <- tr[, -1, drop = FALSE] }
  else stop("unrecognised track format")
  P <- as.matrix(P); if (nrow(P) != length(pos) && ncol(P) == length(pos)) P <- t(P)
  if (nrow(P) != length(pos)) stop("track: number of positions and period rows differ")
  o <- order(pos); pos <- pos[o]; P <- P[o, , drop = FALSE]
  bad <- !is.finite(P) | P <= 0
  if (any(bad)) for (j in which(colSums(bad) > 0)) { k <- !bad[, j]; if (sum(k) < 2) stop("track realisation with < 2 valid periods"); P[, j] <- approx(pos[k], P[k, j], pos, rule = 2)$y }
  list(position = pos, period = P)
}
#' @keywords internal
#' @noRd
.amc_interp <- function(x, Y, xout) {                       # column-wise linear interpolation, constant beyond the ends
  Y <- as.matrix(Y); o <- order(x); x <- x[o]; Y <- Y[o, , drop = FALSE]; d <- !duplicated(x); x <- x[d]; Y <- Y[d, , drop = FALSE]
  if (length(x) == 1) return(Y[rep(1, length(xout)), , drop = FALSE])
  xo <- pmin(pmax(xout, x[1]), x[length(x)]); i <- findInterval(xo, x, rightmost.closed = TRUE); i[i >= length(x)] <- length(x) - 1
  w <- (xo - x[i]) / (x[i + 1] - x[i])
  Y[i, , drop = FALSE] * (1 - w) + Y[i + 1, , drop = FALSE] * w
}
#' @keywords internal
#' @noRd
.amc_cumfloat <- function(z, P, target) {                    # floating time (kyr) from the top of the grid, trapezoid in 1/period
  P <- as.matrix(P); n <- length(z); if (n < 2) return(matrix(0, 1, ncol(P)))
  inc <- diff(z) * target / ((P[-1, , drop = FALSE] + P[-n, , drop = FALSE]) / 2)
  rbind(0, matrix(apply(inc, 2, cumsum), nrow = n - 1))
}
#' @keywords internal
#' @noRd
.amc_eps <- function(eps, FT, PT, zg, zh, bounds, target, sgn) {
  nseg <- length(FT)
  if (is.numeric(eps) && length(eps) == 1) return(list(source = "user (constant)", cycles = NULL, profile = rep(eps, length(zg))))
  if (is.data.frame(eps)) { e <- approx(sgn * eps$position, eps$eps, zg, rule = 2)$y; return(list(source = "user (profile)", cycles = NULL, profile = e)) }
  cyc <- do.call(rbind, lapply(seq_len(nseg), function(s) { f <- FT[[s]]; tm <- rowMeans(f$mean)
    nodes <- approx(tm, f$z, seq(0, max(tm), by = target), ties = mean)$y; nodes <- unique(nodes[is.finite(nodes)])
    if (length(nodes) < 2) nodes <- c(bounds[s], bounds[s + 1])
    if (!is.null(PT) && length(PT[[s]]) >= 2) {
      d <- sapply(PT[[s]], function(x) diff(approx(x$z, x$T, nodes, rule = 2)$y)); d <- matrix(d, nrow = length(nodes) - 1)
      e <- apply(log(pmax(d, 1e-6)), 1, sd) / sqrt(ncol(d)); src <- "proxy se"
    } else {
      d <- apply(f$T, 2, function(t) diff(approx(f$z, t, nodes, rule = 2)$y)); d <- matrix(d, nrow = length(nodes) - 1)
      e <- apply(log(pmax(d, 1e-6)), 1, sd); src <- "track realisations" }
    data.frame(segment = s, top = nodes[-length(nodes)], bottom = nodes[-1], eps = e, source = src) }))
  cyc$eps[!is.finite(cyc$eps)] <- median(cyc$eps, na.rm = TRUE); if (all(!is.finite(cyc$eps))) cyc$eps <- 0.05
  prof <- numeric(length(zg)); sz <- findInterval(zg, zh, left.open = TRUE) + 1
  for (s in seq_len(nseg)) { k <- cyc$segment == s; u <- sz == s; if (!any(u)) next
    m <- (cyc$top[k] + cyc$bottom[k]) / 2
    prof[u] <- if (sum(k) > 1) approx(m, cyc$eps[k], zg[u], rule = 2)$y else cyc$eps[k] }
  cyc$top <- sgn * cyc$top; cyc$bottom <- sgn * cyc$bottom
  list(source = unique(cyc$source), cycles = cyc, profile = prof)
}
#' @keywords internal
#' @noRd
.amc_bchron <- function(dates, zg, zh, sgn, sc, split, args, verbose) {
  run1 <- function(d, zp) {
    a <- list(ages = d$age * sc, ageSds = d$sd * sc, positions = -(sgn * d$position), positionThicknesses = abs(d$thickness), ids = d$id,
              predictPositions = -zp, MC = 10000, burn = 2000)                 # modBchron works in height (increasing upwards), kyr
    for (nm in setdiff(names(args), c("truncateUp", "truncateDown"))) a[[nm]] <- args[[nm]]
    if (!is.null(args$truncateUp)) a$truncateUp <- args$truncateUp * sc          # truncation ages in age_unit
    if (!is.null(args$truncateDown)) a$truncateDown <- args$truncateDown * sc
    if (verbose) cat(sprintf("modBchron: %d dates, %d iterations\n", nrow(d), a$MC))
    m <- if (verbose) do.call(modBchron, a) else { utils::capture.output(r <- do.call(modBchron, a)); r }
    keep <- m$burn:ncol(m$model); list(fit = m, curves = m$model[, keep, drop = FALSE]) }
  if (!split || !length(zh)) { r <- run1(dates, zg); C <- r$curves; fits <- list(r$fit); hz <- NULL }
  else {
    s_d <- findInterval(sgn * dates$position, zh, left.open = TRUE) + 1; s_g <- findInterval(zg, zh, left.open = TRUE) + 1
    C <- NULL; fits <- list(); edge <- list()
    for (s in sort(unique(s_g))) { d <- dates[s_d == s, ]
      if (nrow(d) < 2) { warning(sprintf("segment %d has < 2 dates; modBchron run with all dates there", s)); d <- dates }
      zp <- sort(unique(c(zg[s_g == s], if (s > 1) zh[s - 1], if (s <= length(zh)) zh[s])))
      r <- run1(d, zp); fits[[s]] <- r$fit; n <- min(ncol(r$curves), if (is.null(C)) Inf else ncol(C))
      edge[[s]] <- list(z = zp, curves = r$curves)
      cs <- r$curves[match(zg[s_g == s], zp), seq_len(n), drop = FALSE]
      C <- if (is.null(C)) cs else rbind(C[, seq_len(n), drop = FALSE], cs) }
    hz <- do.call(rbind, lapply(seq_along(zh), function(h) { up <- edge[[h]]; lo <- edge[[h + 1]]; n <- min(ncol(up$curves), ncol(lo$curves))
      d <- lo$curves[match(zh[h], lo$z), seq_len(n)] - up$curves[match(zh[h], up$z), seq_len(n)]; d <- d[d > 0]
      q <- quantile(d, c(.5, .025, .975)); data.frame(position = sgn * zh[h], median_kyr = q[[1]], plus_kyr = q[[3]] - q[[1]], minus_kyr = q[[1]] - q[[2]]) }))
    if (verbose) for (h in seq_len(nrow(hz))) cat(sprintf("modBchron (split): hiatus at %g = %.0f +%.0f/-%.0f kyr\n", hz$position[h], hz$median_kyr[h], hz$plus_kyr[h], hz$minus_kyr[h]))
  }
  qq <- apply(C, 1, quantile, c(.025, .5, .975), na.rm = TRUE)
  list(fits = fits, model = C / sc, predictPositions = sgn * zg, sd2_kyr = 2 * apply(C, 1, sd, na.rm = TRUE),
       summary = data.frame(position = sgn * zg, mean = rowMeans(C, na.rm = TRUE) / sc, median = qq[2, ] / sc, lower = qq[1, ] / sc, upper = qq[3, ] / sc,
                            sd2_kyr = 2 * apply(C, 1, sd, na.rm = TRUE)),
       hiatus = hz, split = split)
}

## ============================================================================= methods
#' @export
print.astroMCBchron <- function(x, ...) {
  s <- x$settings; u <- s$age_unit
  cat(sprintf("astroMCBchron model: %d dates, %d hiatus(es); anchor %s; tau from %s; %d posterior draws, %d curves stored\n",
              nrow(x$dates), NCOL(x$hiatus), s$anchor, s$tau_source, length(x$posterior), s$curves_stored))
  d <- x$dates; show <- data.frame(id = d$id, position = d$position, date = round(d$date, 3), posterior = round(d$posterior, 3),
                                   `2sd_kyr` = round(d$posterior_2sd_kyr), shift_kyr = round(d$shift_kyr), shift_sd = round(d$shift_sd, 2), outlier = d$outlier, check.names = FALSE)
  if (!is.null(d$loo_z)) show$loo_z <- round(d$loo_z, 2)
  cat(sprintf("\nDates (%s) and posterior ages:\n", u)); print(show, row.names = FALSE)
  cat("\nStretch factors (median [95%]):\n")
  print(data.frame(interval = colnames(x$stretch), median = round(apply(x$stretch, 2, median), 2), lower = round(apply(x$stretch, 2, quantile, .025), 2),
                   upper = round(apply(x$stretch, 2, quantile, .975), 2)), row.names = FALSE)
  if (NCOL(x$hiatus)) for (h in seq_len(ncol(x$hiatus))) cat(sprintf("Hiatus at %s: %.0f +/- %.0f kyr (2 sd)\n", sub("hiatus_", "", colnames(x$hiatus)[h]),
                                                                    mean(x$hiatus[, h]), 2 * sd(x$hiatus[, h])))
  cat(sprintf("tau0: %.3f [%.3f-%.3f]\n", median(x$tau0), quantile(x$tau0, .025), quantile(x$tau0, .975)))
  if (!is.null(x$comparison)) { k <- x$comparison$position >= min(x$dates$position) & x$comparison$position <= max(x$dates$position)
    cat(sprintf("2 sd reduction vs modBchron between the outermost dates: mean %.0f%%, median %.0f%%\n", mean(x$comparison$reduction_pct[k], na.rm = TRUE),
                median(x$comparison$reduction_pct[k], na.rm = TRUE))) }
  invisible(x)
}
#' @export
summary.astroMCBchron <- function(object, ...) object$summary

#' Predict ages at new positions from an astroMCBchron model
#'
#' @param object an \code{astroMCBchron} object.
#' @param newPositions positions (same type and unit as the model).
#' @param side for positions exactly at a hiatus: "upper" (younger side, default) or "lower".
#' @param ... unused.
#' @return list with \code{raw} (draws x positions, in age units) and \code{HDI}
#'   (position, 2.5, 50 and 97.5 percentiles).
#' @export
predict.astroMCBchron <- function(object, newPositions, side = c("upper", "lower"), ...) {
  side <- match.arg(side); sgn <- if (object$settings$position_type == "depth") 1 else -1
  zg <- sgn * object$predictPositions; zn <- sgn * newPositions
  zh <- if (NCOL(object$hiatus)) sgn * object$settings$hiatuses$position else numeric(0)
  sg <- findInterval(zg, zh, left.open = TRUE); sn <- findInterval(zn, zh, left.open = side == "upper")
  if (any(zn < min(zg) | zn > max(zg))) stop("newPositions outside the model range")
  raw <- matrix(NA_real_, ncol(object$model), length(zn))
  for (q in unique(sn)) { u <- sn == q; g <- sg == q
    raw[, u] <- t(.amc_interp(zg[g], object$model[g, , drop = FALSE], zn[u])) }
  list(raw = raw, HDI = data.frame(position = newPositions, t(apply(raw, 2, quantile, c(.025, .5, .975), na.rm = TRUE)), check.names = FALSE))
}

#' Plot an astroMCBchron model
#'
#' Three panels: (A) age model (95\% range) with the dates and, if present, the modBchron
#' model; (B) 2 sd age uncertainty of both models; (C) posterior and leave-one-out ages
#' minus the dates. Oldest strata/ages on the left and bottom.
#' @param x an \code{astroMCBchron} object.
#' @param ... unused.
#' @export
plot.astroMCBchron <- function(x, ...) {
  op <- graphics::par(no.readonly = TRUE); on.exit(graphics::par(op))
  s <- x$summary; d <- x$dates; u <- x$settings$age_unit; dep <- x$settings$position_type == "depth"
  xl <- if (dep) rev(range(s$position)) else range(s$position)                # oldest strata on the left
  graphics::layout(matrix(c(1, 1, 2, 3), 2, byrow = TRUE), heights = c(1.3, 1)); graphics::par(mar = c(4, 4.5, 1.5, 1), mgp = c(2.4, .7, 0))
  yl <- rev(range(c(s$lower, s$upper, d$date)))                               # oldest ages at the bottom
  plot(NA, xlim = xl, ylim = yl, xlab = sprintf("Position (%s)", x$settings$position_type), ylab = sprintf("Age (%s)", u))
  if (!is.null(x$bchron)) { b <- x$bchron$summary; graphics::polygon(c(b$position, rev(b$position)), c(b$lower, rev(b$upper)), col = grDevices::adjustcolor("grey60", .35), border = NA)
    graphics::lines(b$position, b$median, lty = 2, col = "grey30") }
  graphics::polygon(c(s$position, rev(s$position)), c(s$lower, rev(s$upper)), col = grDevices::adjustcolor("steelblue", .45), border = NA)
  graphics::lines(s$position, s$median, col = "navy", lwd = 1.6)
  k2 <- d$date_2sd_kyr / (if (u == "Ma") 1000 else 1)
  graphics::arrows(d$position, d$date - k2, d$position, d$date + k2,
                   angle = 90, code = 3, length = .03, col = "firebrick", lwd = 1.4)
  graphics::points(d$position, d$date, pch = 21, bg = ifelse(d$outlier, "white", "firebrick"), cex = .9)
  if (NCOL(x$hiatus)) graphics::abline(v = x$settings$hiatuses$position, lty = 4, col = "darkorange")
  graphics::legend(if (dep) "topleft" else "topright", bty = "n", cex = .8, legend = c("astroMCBchron (median, 95%)", if (!is.null(x$bchron)) "modBchron (median, 95%)", "dates (2 sd)"),
                   col = c("navy", if (!is.null(x$bchron)) "grey30", "firebrick"), lty = c(1, if (!is.null(x$bchron)) 2, NA), pch = c(NA, if (!is.null(x$bchron)) NA, 21),
                   pt.bg = "firebrick", lwd = c(1.6, if (!is.null(x$bchron)) 1, NA))
  graphics::mtext("A", 3, .2, adj = 0, font = 2)
  ym <- max(c(s$sd2_kyr, if (!is.null(x$bchron)) x$bchron$summary$sd2_kyr, d$date_2sd_kyr), na.rm = TRUE)
  plot(s$position, s$sd2_kyr, type = "l", col = "navy", lwd = 1.6, xlim = xl, ylim = c(0, ym * 1.05), xlab = sprintf("Position (%s)", x$settings$position_type), ylab = "2 sd (kyr)")
  if (!is.null(x$bchron)) graphics::lines(x$bchron$summary$position, x$bchron$summary$sd2_kyr, lty = 2, col = "grey30")
  graphics::points(d$position, d$date_2sd_kyr, pch = 23, bg = "firebrick", cex = .8); graphics::mtext("B", 3, .2, adj = 0, font = 2)
  o <- order(d$position, decreasing = dep); dd <- d[o, ]; n <- nrow(dd); xx <- seq_len(n)
  graphics::par(mar = c(7.5, 4.5, 1.5, 1))
  yr <- range(c(dd$shift_kyr - dd$posterior_2sd_kyr, dd$shift_kyr + dd$posterior_2sd_kyr, -dd$date_2sd_kyr, dd$date_2sd_kyr,
                if (!is.null(dd$loo_pred)) c((dd$loo_pred - dd$date) * (if (u == "Ma") 1000 else 1) + c(-1, 1) %o% dd$loo_2sd_kyr)), na.rm = TRUE)
  plot(NA, xlim = c(.5, n + .5), ylim = yr, xaxt = "n", xlab = "", ylab = "Model age - date (kyr)")
  graphics::axis(1, xx, labels = dd$id, las = 2, cex.axis = .7)
  graphics::rect(xx - .35, -dd$date_2sd_kyr, xx + .35, dd$date_2sd_kyr, col = grDevices::adjustcolor("firebrick", .15), border = NA); graphics::abline(h = 0, col = "grey50")
  graphics::arrows(xx - .1, dd$shift_kyr - dd$posterior_2sd_kyr, xx - .1, dd$shift_kyr + dd$posterior_2sd_kyr, angle = 90, code = 3, length = .02, col = "navy")
  graphics::points(xx - .1, dd$shift_kyr, pch = 19, col = "navy", cex = .7)
  if (!is.null(dd$loo_pred)) { lp <- (dd$loo_pred - dd$date) * (if (u == "Ma") 1000 else 1)
    graphics::arrows(xx + .1, lp - dd$loo_2sd_kyr, xx + .1, lp + dd$loo_2sd_kyr, angle = 90, code = 3, length = .02, col = "darkgreen")
    graphics::points(xx + .1, lp, pch = 17, col = "darkgreen", cex = .7) }
  graphics::mtext("C", 3, .2, adj = 0, font = 2)
  invisible(x)
}
